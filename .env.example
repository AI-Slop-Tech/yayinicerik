# ---- Ortak ----
NODE_ENV=production
# En az 32 karakter; web ve realtime AYNI değeri kullanmalı (kimlik belirteçleri bununla imzalanır).
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATABASE_URL=postgres://kngl:kngl@postgres:5432/kngl
REDIS_URL=redis://redis:6379

# ---- Web ----
NEXT_PUBLIC_SITE_URL=https://kngldublaj.com
# Boş bırakılırsa tarayıcı aynı origin üzerinden /socket.io'ya bağlanır (nginx yönlendirir).
NEXT_PUBLIC_REALTIME_URL=
UPLOAD_DIR=/data/uploads
MEDIA_BASE_URL=/media
PG_POOL_MAX=10
DISCORD_INVITE_URL=https://discord.gg/kngl
# next/image için izinli uzak görsel alan adları (virgülle)
MEDIA_HOSTS=

# ---- Realtime ----
PORT=4000
CORS_ORIGINS=https://kngldublaj.com

# ---- Worker ----
SCENE_MEDIA_DIR=/data/media/scenes
OUTPUT_DIR=/data/media/dubs
RENDER_CONCURRENCY=2
WATERMARK_TEXT=KNGL Dublaj
FFMPEG_PATH=ffmpeg

# ---- Postgres (docker-compose) ----
POSTGRES_USER=kngl
POSTGRES_PASSWORD=kngl
POSTGRES_DB=kngl
