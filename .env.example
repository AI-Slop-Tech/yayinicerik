# ---- docker compose (Coolify dışı) için: Coolify bu üç değeri kendisi üretir ----
# En az 32 karakter; web ve realtime aynı değeri kullanır (kimlik belirteçleri bununla imzalanır).
SERVICE_PASSWORD_64_SESSION=change-me-to-a-long-random-string-at-least-32-chars
SERVICE_PASSWORD_POSTGRES=change-me-postgres-password
# Yönetim paneli (/admin) şifresi, en az 8 karakter
SERVICE_PASSWORD_ADMIN=change-me-admin-password
# Sitenin dışarıdan görünen adresi (bağlantılar ve SEO için)
PUBLIC_URL=http://SUNUCU_IP:8420
# Socket.IO adresi. Boş bırakılırsa tarayıcı otomatik olarak http://AYNI_HOST:4001 dener.
# Ters proxy arkasındaysan tam adresi yaz (ör. https://kngldublaj.com veya wss://...)
NEXT_PUBLIC_REALTIME_URL=
# Realtime CORS: boş = tüm origin'lere izin (doğrudan port erişimi için gerekir)
CORS_ORIGINS=

# ---- isteğe bağlı ----
PG_POOL_MAX=10
DISCORD_INVITE_URL=https://discord.gg/kngl
RENDER_CONCURRENCY=2
WATERMARK_TEXT=KNGL Dublaj

# ---- Disk (sunucu alanı kısıtlıysa bunları küçült) ----
# Kaynak videoların toplam üst sınırı (GB). Kaynaklar geçicidir, kesildikten sonra silinir.
MAX_SOURCE_GB=5
# Sahne videosu kalitesi: büyük değer = küçük dosya. 23 net, 26 dengeli, 28 idareli.
SCENE_CRF=26
# Prömiyer videoları kaç gün saklanır (öne çıkarılanlar hariç)
DUB_RETENTION_DAYS=30
# Kesilmeden bırakılan kaynaklar kaç saat sonra silinir
SOURCE_TTL_HOURS=24
# Web'in sunucuda bağlandığı port (site http://SUNUCU_IP:BU_PORT adresinden açılır)
# Sunucuda doluysa başka bir değer verin; "port is already allocated" hatası bundan çıkar.
HTTP_PORT=8420
# Realtime (Socket.IO) portu
REALTIME_PORT=4001

# ---- yerel geliştirme (npm run dev:*) ----
# DATABASE_URL=postgres://kngl:kngl@localhost:5432/kngl
# REDIS_URL=redis://localhost:6379
# SESSION_SECRET=dev-only-secret-change-me-in-production-please-0000
# NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
